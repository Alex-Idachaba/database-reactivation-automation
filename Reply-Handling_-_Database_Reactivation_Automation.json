      "id": "89db746b-e545-4032-a745-01794cac8e66",
      "name": "Gmail Trigger - New Reply"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT rc.id, rc.contact_id, rc.cohort, c.full_name, c.email\nFROM reactivation_campaigns rc\nJOIN contacts c ON c.id = rc.contact_id\nWHERE c.email = $1\n  AND rc.reply_intent IS NULL\nORDER BY rc.campaign_run_at DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.from.value[0].address }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -1008,
        16
      ],
      "id": "9cb08920-1ac2-4368-99c4-c15a7e3c9c60",
      "name": "Postgres - Find Open Campaign For Sender"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Classify this reply:\n\n{{ $('Gmail Trigger - New Reply').item.json.text }}"
            },
            {
              "role": "system",
              "content": "You are classifying a customer's email reply to a re-engagement outreach\nmessage. Read the reply and determine the customer's intent.\n\nClassify into exactly one of these four categories:\n- interested: the customer clearly wants to continue the conversation, asks\n  a question, or gives a clear affirmative signal.\n- not_interested: the customer clearly declines or indicates they don't\n  want to proceed.\n- unsubscribe: the customer explicitly asks to stop being contacted, opt\n  out, or be removed from future outreach.\n- needs_follow_up: the reply is ambiguous, noncommittal, or doesn't clearly\n  fit any of the above — for example, hedging language, uncertainty, or a\n  reply that doesn't directly address the question asked.\n\nThe reply may include quoted text from the original outreach email below\nthe new message — only classify based on the customer's own new reply text,\nignore the quoted portion.\n\nOutput only one word: interested, not_interested, unsubscribe, or\nneeds_follow_up. No punctuation, no explanation, nothing else."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -800,
        16
      ],
      "id": "42563d01-5367-40fe-8703-0afb62c64f20",
      "name": "OpenAI - Classify Reply Intent"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE reactivation_campaigns\nSET reply_intent = $1,\n    reactivated_at = CASE WHEN $1 = 'interested' THEN now() ELSE NULL END\nWHERE id = $2\nRETURNING id, reply_intent, reactivated_at;",
        "options": {
          "queryReplacement": "={{ $json.output[0].content[0].text }} {{ $('Postgres - Find Open Campaign For Sender').item.json.id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -464,
        16
      ],
      "id": "e764f3e3-05d7-4de2-b500-498e66a4644b",
      "name": "Postgres - Update Reply Intent"
    },

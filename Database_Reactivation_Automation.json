      "parameters": {
        "jsCode": "const validSegments = ['high_value', 'standard', 'low_engagement'];\n\nreturn $input.all().map(item => {\n  const segment = validSegments.includes(item.json.segment)\n    ? item.json.segment\n    : 'standard';\n\n  return {\n    json: {\n      ...item.json,\n      segment\n    }\n  };\n});"
      },

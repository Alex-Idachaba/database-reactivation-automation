    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id, c.full_name, c.email, c.phone, c.segment\nFROM contacts c\nWHERE c.last_activity_at < now() - interval '90 days'\n  AND c.id NOT IN (\n      SELECT contact_id\n      FROM reactivation_campaigns\n      WHERE reactivated_at IS NOT NULL\n        AND campaign_run_at > now() - interval '90 days'\n  );",
        "options": {}
      },
